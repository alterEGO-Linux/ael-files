#!/usr/bin/env bash
# =============================================================================
# INFO
# =============================================================================
# [/bin/delete]
# 
# Author      : Pascal Malouin (https://github.com/alterEGO-Linux)
# Created     : 2026-04-04 13:34:04 UTC
# Updated     : 2026-08-31 12:58:48 UTC
# Description : Delete directories.
# -----------------------------------------------------------------------------

delete() {

    source ${HOME}/.ael/lib/bash/ael
    import applications
    import messages
    
    if [ "$#" -eq 0 ]; then
        message error "Usage: delete <dir1> [dir2] [dir3] ..."
        return 1
    fi

    local dir
    for dir in "${@}"; do
        if [ -d "${dir}" ]; then
            message step "Processing deletion: ${dir} ..."

            # --- Confirmation request.
            # ... Will exit in non-interactive context.
            if [[ ! -t 0 ]]; then
                message error "No interactive terminal available for confirmation prompt." >&2
                return 1
            fi
            
            local input
            message step "Are you sure you want to delete this directory? [y/N] "
            read -r input
            
            if [[ "${input}" =~ ^([yY][eE][sS]|[yY])$ ]]; then
                command rm --recursive --force "${dir}" 
                message step "Deleted: '${dir}'."
            else
                message error "Skipping: '${dir}'."
            fi
        else
            message error "'${dir}' is not a directory or does not exist!"
        fi
    done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    delete "$@"
fi
