#! /usr/bin/env bash
# =============================================================================
# INFO
# =============================================================================
# [/bin/pacman-reset]
# 
# Author      : Pascal Malouin (https://github.com/alterEGO-Linux)
# Created     : 2023-10-20 10:46:22 UTC
# Updated     : 2026-08-30 15:42:02 UTC
# Description : Re-initialize pacman sync, mirrorlist and keyring.
# -----------------------------------------------------------------------------

pacman-reset() {

    source ~/.ael/lib/bash/ael

    import applications
    import messages
        
    check_applications reflector sudo pacman sed || return 1

    message banner "pacmn-reset - Re-initializing Pacman."

    message step "Removing sync file."
    sudo $(command -v rm) -rf /var/lib/pacman/sync

    # Resetting mirror list using `reflector` instead of curl.
    message step "Resetting mirrorlist."
    sudo reflector --country Canada --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist

    message step "Updating archlinux-keyring."
    sudo $(command -v pacman) -Syy --noconfirm archlinux-keyring

    message success "All done!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    pacman-reset
fi
