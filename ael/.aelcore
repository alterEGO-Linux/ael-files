export PS4

# -------------------- ( ael )

export AEL_FILES_REPOSITORY="https://github.com/alterEGO-Linux/ael-files"
export AEL_FILES="${HOME}/.local/share/ael-files"
export AEL_DIR="${HOME}/.ael"
export AEL_BIN="${AEL_DIR}/bin"
export AEL_DATA="${AEL_DIR}/data"
export AEL_SHELLUTILS="${AEL_DIR}/shellutils"
export AEL_CUSTOM="${AEL_DIR}/custom"
export AEL_DEBUG_LEVEL=2

# -------------------- ( default apps )

export BROWSER=firefox
export TERMINAL="alacritty"
export VISUAL=vim
export EDITOR=${VISUAL}
export MANPAGER='bat -l man -p'
export FZF_DEFAULT_COMMAND='rg --files --hidden --follow '

# -------------------- ( shellutils )

# --- ( ansi-colors )
shellutil="${AEL_SHELLUTILS}/ansi-colors"

if [[ -f "${shellutil}" ]]; then
    . "${shellutil}"
else
    # --- Colors fallback
    export reset=$'\e[0m'
    export fg_blue=$'\e[34m'
    export fg_green=$'\e[32m'
    export fg_red=$'\e[31m'
    export fg_yellow=$'\e[33m'
    if (( ${AEL_DEBUG_LEVEL:-0} >= 1 )); then
        printf '%s\n' "${fg_red}[!]${reset} ${shellutil} is missing..." 
        printf '%s\n' "${fg_red}[!]${reset} Try ael-help for documentation." 
    fi
fi

export TERM="${TERM:-xterm-256color}"

# --- ( ael-help )
shellutil="${AEL_SHELLUTILS}/ael-help"

if [[ -f "${shellutil}" ]]; then
    . "${shellutil}"
else
    # --- Help fallback.
    if (( ${AEL_DEBUG_LEVEL:-0} >= 1 )); then
        printf '%s\n' "${fg_red}[!]${reset} ${shellutil} is missing..." 
        ael-help() {
            cat <<EOF
===============================================================================
[+] ael-help fallback
-------------------------------------------------------------------------------

It looks like some modules of alterEGO Linux are missing or not installed
properly (including ael-help).

You can find the full documentation at:
${AEL_FILES_REPOSITORY}/documentation

Locally, it should be at the following location:
${AEL_FILES}/documentation

-------------------------------------------------------------------------------
EOF
        }
    fi
fi

# --- ( simple sourcing )
load-module() {
    local module
    module="$@"

    if [[ -f "${module}" ]]; then
        . "${module}"
    else
        if (( ${AEL_DEBUG_LEVEL:-0} >= 1 )); then
            printf '%s\n' "${fg_red}[!]${reset} ${module} is missing..." 
            printf '%s\n' "${fg_red}[!]${reset} Try ael-help for documentation." 
        fi
    fi
}

