#!/usr/bin/env bash
# =============================================================================
# INFO
# =============================================================================
# [/bin/processes]
# 
# Author      : Pascal Malouin (https://github.com/alterEGO-Linux)
# Created     : 2023-08-02 00:51:54 UTC
# Updated     : 2026-09-01 20:12:59 UTC
# Description : Show processes.
# -----------------------------------------------------------------------------

processes() {

    source ${HOME}/.ael/lib/bash/ael
    import applications messages

    check_applications ps || return 1

    message banner "processes - Show processes"

    if [[ $(command -v grc) ]]; then
        command grc ps aux
    else
        command ps aux
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    processes
fi
