#!/usr/bin/env bash
# ------------------------------------------------------------------------ INFO
# [/ael/bin/install-paru]
# author        : Pascal Malouin @https://github.com/fantomH
# created       : 2026-04-16 17:52:37 UTC
# updated       : 2026-04-16 17:52:37 UTC
# description   : Install AUR package manager PARU.

# --| build directory
__cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
__base_build_dir="${AEL_BUILD:-$__cache_home/ael}"
__BUILD_DIR="${__base_build_dir}/paru"

check_applications() {
  local __app
  for __app in "${@}"; do
      if ! command -v $__app >/dev/null 2>&1; then
          printf '%s\n' "${__red}[!]${__reset} ${__app} is not installed."
          return 1
      fi
  done
}
check_applications git makepkg sudo pacman || exit 1

install_paru() {

    sudo pacman -S --needed base-devel
    cd "${__BUILD_DIR}"
    git clone https://aur.archlinux.org/paru.git
    cd paru
    makepkg -si

}

[[ $# -eq 0 ]] && { exit 1; }

for arg in "$@"; do
		case "${arg}" in
        --install)
            install_paru
            exit 0
            ;;

				-h|--help)
            echo
						exit 0
						;;
		esac
done
