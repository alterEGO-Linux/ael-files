#! /usr/bin/env bash
# =============================================================================
# INFO
# =============================================================================
# [/bin/ports]
# 
# Author      : Pascal Malouin (https://github.com/alterEGO-Linux)
# Created     : 2023-08-04 02:11:08 UTC
# Updated     : 2026-08-31 21:32:07 UTC
# Description : Displays open ports.
# -----------------------------------------------------------------------------

ports() {

    source ${HOME}/.ael/lib/bash/ael
    import applications messages

    check_applications sudo netstat || return 1

    message banner "ports - Displays open ports"

    if [[ $(command -v grc) ]]; then
        sudo grc netstat -tulanp
    else
        sudo netstat -tulanp
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    ports
fi
