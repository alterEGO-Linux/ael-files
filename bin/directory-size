#!/usr/bin/env bash
# =============================================================================
# INFO
# =============================================================================
# [/bin/directory-size]
# 
# Author      : Pascal Malouin (https://github.com/alterEGO-Linux)
# Created     : 2023-08-01 20:01:01 UTC
# Updated     : 2026-08-31 16:00:34 UTC
# Description : Check size of biggest directories.
# -----------------------------------------------------------------------------

directory-size() {

    source ${HOME}/.ael/lib/bash/ael
    import messages

    message banner "[+] directory-size"
    message step "Size of current directory, followed by biggest child directories:"

    command du --bytes --human-readable --max-depth 1 2> /dev/null \
    | command sort --reverse --human-numeric-sort \
    | command head
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    directory-size
fi
