# --- ( python ) --------------------------------------------------------------

# [+] python - ael env --------------------------------------------------------
# --| rev. 2026-04-15

snippet py_ael_env "PYTHON - AEL env." b
from pathlib import Path
import os

__cache_home = Path(os.getenv("XDG_CACHE_HOME") or (Path.home() / ".cache"))
__base_build_dir = Path(os.getenv("AEL_BUILD") or (__cache_home / "ael" / "build"))
BUILD_DIR = __base_build_dir / "kali-on-ael" / container_name
endsnippet

# --- ( shell ) ---------------------------------------------------------------

# [+] shell - case statement --------------------------------------------------
# --| rev. 2026-04-03

snippet sh_case_statement "SHELL - case statement" b
# --| No args.
[[ $# -eq 0 ]] && { <do something>; return 1; }

for arg in "$@"; do
		case "${arg}" in
				-h|--help)
						usage
						return 1
						;;
		esac
done
endsnippet

# [+] shell - check applications ----------------------------------------------
# --| rev. 2026-04-10

snippet sh_check_applications "SHELL - check applications" b
check_applications() {
	local __app
	for __app in "${@}"; do
			if ! command -v $__app >/dev/null 2>&1; then
					printf '%s\n' "${__red}[!]${__reset} ${__app} is not installed."
					return 1
			fi
	done
}
check_applications git || return 1
endsnippet

# [+] shell - colors ----------------------------------------------------------
# --| rev. 2026-04-02

snippet sh_colors "SHELL - colors" b
local __blue=$'\033[34m'
local __bold=$'\033[1m'
local __red=$'\033[31m'
local __reset=$'\033[0m'
local __yellow=$'\033[33m'
endsnippet

# [+] shell -> AEL build directory. -------------------------------------------
# --| rev. 2026-04-17

snippet sh_ael_build "SHELL - AEL build directory" b
# --| build directory
__cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
__base_build_dir="${AEL_BUILD:-$__cache_home/ael}"
__BUILD_DIR="${__base_build_dir}/<directory>"
endsnippet

# [+] shell -> Fuzzy Finder. --------------------------------------------------
# --| rev. 2026-04-17
# ..| usage: fuzzyfinder

snippet sh_fuzzy_finder "SHELL - Fuzzy Finder" b
fuzzyfinder() {
		local __preview_window
		local __height __width

		__height=$(tput lines)
		__width=$(tput cols)

		if (( __width < 100 || __height < 30 )); then
				__preview_window="down:80%"
		else
				__preview_window="right:80%"
		fi

		fzf --color=gutter:-1    \
				--margin=1%          \
				--border=rounded     \
				--prompt="CHEAT ❯ "  \
				--header=" "         \
				--no-hscroll         \
				--reverse            \
				-i                   \
				--exact              \
				--tiebreak=begin     \
				--no-info            \
				--color "header:66,prompt:66,pointer:66,marker:67,fg+:white,bg+:black" \
				--preview-window="${__preview_window}" \
				--bind 'ctrl-/:change-preview-window(right,80%|down,80%|hidden)' \
				--preview 'command cat <(command curl -s cheat.sh/{})'

}
endsnippet

# [+] shell - main guard ------------------------------------------------------
# --| rev. 2026-04-01
# ..| Same purpose as Python __name__ == "__main__".

snippet sh_main_guard "SHELL - main guard" b
if [[ "${BASH_SOURCE[0]}" == "\${0}" ]]; then
    <function> "$@"
fi
endsnippet

# [+] shell - question --------------------------------------------------------
# --| rev. 2026-04-01

snippet sh_question "SHELL - question" b
# --| Confirmation request.
# ..| Will exit in non-interactive context.
if [[ ! -t 0 ]]; then
		printf '%s\n' "${__red}[!]${__reset} No interactive terminal available for confirmation prompt." >&2
		return 1
fi

local __input
printf "${__blue}[?]${__reset} <question>? [y/N] "
read -r __input

if [[ "${__input}" =~ ^([yY][eE][sS]|[yY])$ ]]; then
		: # --| this does nothing.
else
		<do something>
fi
endsnippet

# [+] shell - trap functions --------------------------------------------------
# --| rev. 2026-04-02

snippet sh_trap_functions "SHELL - trap functions" b
trap 'unset -f <functions>; trap - RETURN' RETURN
endsnippet

# [+] shell - Usage -----------------------------------------------------------
# --| rev. 2026-04-02

snippet sh_usage "SHELL - Usage" b
usage() {
	cat <<EOF
================================================================================
[+] <function name> - <function description>
================================================================================
Usage:
  <function name> [-h|--help] [-s|--status] <message...>

Options:
  -h, --help    Show this help.
  -s, --status  Show status and exits.

<...>
================================================================================
EOF
}
endsnippet

