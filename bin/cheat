#!/usr/bin/env bash
# ------------------------------------------------------------------------ INFO
# [/ael/bin/cheat]
# author        : Pascal Malouin (https://github.com/alterEGO-Linux)
# created       : 2023-08-01 19:57:57 UTC
# updated       : 2026-04-17 12:39:00 UTC
# description   : Query https://cheat.sh.

cheat() {

    # --| ref. <https://github.com/chubin/cheat.sh>

    local __cheat

    trap 'unset -f check_applications fuzzyfinder; trap - RETURN' RETURN

    check_applications() {
      local __app
      for __app in "${@}"; do
          if ! command -v $__app >/dev/null 2>&1; then
              printf '%s\n' "${__red}[!]${__reset} ${__app} is not installed."
              return 1
          fi
      done
    }
    check_applications cat curl fzf less || return 1

    fuzzyfinder() {
        local __preview_window
        local __height __width

        __height=$(tput lines)
        __width=$(tput cols)

        if (( __width < 100 || __height < 30 )); then
            __preview_window="down:80%"
        else
            __preview_window="right:80%"
        fi

        fzf --color=gutter:-1    \
            --margin=1%          \
            --border=rounded     \
            --prompt="CHEAT ❯ "  \
            --header=" "         \
            --no-hscroll         \
            --reverse            \
            -i                   \
            --exact              \
            --tiebreak=begin     \
            --no-info            \
            --color "header:66,prompt:66,pointer:66,marker:67,fg+:white,bg+:black" \
            --preview-window="${__preview_window}" \
            --bind 'ctrl-/:change-preview-window(right,80%|down,80%|hidden)' \
            --preview 'command cat <(command curl -s cheat.sh/{})'
    }

    __cheat="$(command curl -s cheat.sh/:list \
               | fuzzyfinder)"
                     
    if [[ -n ${__cheat} ]]; then
        command curl -s cheat.sh/"${__cheat}" | command less -R
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    cheat "$@"
fi
