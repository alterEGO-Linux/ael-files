# [+] --------------------------------------------------------------| dircolors

# --| LS_COLORS
shellutil="${AEL_SHELLUTILS}/dircolors"

if [[ -f "${shellutil}" ]]; then
    eval "$(dircolors --sh ${shellutil})"
else
    # --- Fallback.
    eval "$(dircolors --sh)"
    if (( ${AEL_DEBUG_LEVEL:-0} >= 1 )); then
        printf '%s\n' "${fg_red}[!]${reset} ${shellutil} is missing..." 
        printf '%s\n' "${fg_red}[!]${reset} Try ael-help for documentation." 
    fi
fi

# [+] ----------------------------------------------------------------| aliases

alias grep="grep --color=auto"
alias ll='ls --all --human-readable -l --color=auto'
alias ls='ls --all --color=auto'
alias lt='ls --format=long --sort=time --all --human-readable'

# --| Makes tmux understand the environment is important.
alias tmux="env TERM=screen-256color tmux -u"

# --| .ael/custom/aliases -> Custom aliases file.
load-source "${AEL_CUSTOM}/aliases"

# [+] -------------------------------------------------------------------| PATH

# --| ref. <https://www.linuxjournal.com/content/removing-duplicate-path-entries>
PATH="${HOME}/.ael/bin:${HOME}/.local/bin:${PATH}:${HOME}/scripts:${HOME}/bin"
PATH=$(printf '%s' "${PATH}" | awk -v RS=: '!($0 in a) {a[$0]; printf("%s%s", length(a) > 1 ? ":" : "", $0)}')

export PATH

# [+] ----------------------------------------------------------------| HISTORY

# --| Allows custom HISTIGNORE patterns.
# ..| Excepted /.ael/custom/histignore file.
histignore_default=(
    "cd"
    "history"
    "history *"
    "ls"
    "pwd"
)

patterns=("${histignore_default[@]}")

histignore="${AEL_CUSTOM}/histignore"

if [[ -f "$histignore" ]]; then
    while IFS= read -r line; do

        # --| Trim leading whitespace.
        line="${line#"${line%%[![:space:]]*}"}"

        # --| Trim trailing whitespace.
        line="${line%"${line##*[![:space:]]}"}"

        # --| Skip commented lines.
        [[ "${line}" =~ ^# ]] && continue

        # --| Skip empty lines.
        [[ -z "$line" ]] && continue

        patterns+=("$line")
    done < "$histignore"
fi

HISTIGNORE="$(IFS=:; printf '%s' "${patterns[*]}")"

export HISTIGNORE
export HISTCONTROL=ignorespace
export HISTSIZE=1000000
export HISTFILESIZE=1000000
export HISTTIMEFORMAT="%Y-%m-%d %T %z "

# [+] ------------------------------------| TERMINAL BEHAVIOR / CTRL+S / CTRL+Q

# --| Enable Ctrl+S inside terminal applications (e.g. Vim).
# ..| By default, the terminal uses Ctrl+S / Ctrl+Q for software flow control:
# ..| - Ctrl+S → pauses terminal output
# ..| - Ctrl+Q → resumes output
# ..| This prevents applications like Vim from receiving Ctrl+S.
# ..| Disabling flow control with `stty -ixon` frees Ctrl+S so it can be used
# ..| as a normal keybinding (e.g. save in Vim).
# ..| Example Vim mapping:
# ..| inoremap <C-s> <ESC>:write<CR>
# ..| Note: This will not work in a remote SSH session.

stty -ixon

# [+] -----------------------------------------------------------------| PROMPT

prompt_command() {
    local style="${1:-default}"

    history -a

    case "$style" in
        simple)
            PS1='[\u@\h \W]\$ '
            ;;

        kali_style)
            PS1="\[${reset}\]\[${fg_green}\]┌────(\[${reset}\]\u@\h\[${fg_green}\])-[\[${reset}\]\w\[${fg_green}\]]\n\[${fg_green}\]└─$ \[${reset}\]"
            ;;

        ego)
            PS1="\[${reset}\]\[${fg_green}\](\u@\h)-[\w] • \D{%F %H:%M:%S %Z}\n\[${fg_green}\]❯ \[${reset}\]"
            ;;

        default)
            if [[ $(tty) == /dev/pts/* ]]; then
                PS1="\n\[${reset}\]\[${fg_green}\]╭─(\D{%F %H:%M:%S %Z})-(\j)-(\H)-(\w)\n\[${fg_green}\]│\n\[${fg_green}\]╰──| \[${reset}\]"
            else
                PS1="\[${reset}\]\[${fg_green}\](\u@\h)-[\w] • \D{%F %H:%M:%S %Z}\n\[${fg_green}\]> \[${reset}\]"
            fi
            ;;
    esac
}

PROMPT_COMMAND='prompt_command default'

# [+] -----------------------------------------------------------------| reload

# --| Source again the file that initiated the current shell.

reload() {

    if [[ "${LOADED:-}" = "bashrc" ]]; then
        . "${HOME}/.bashrc"
    elif [[ "${LOADED:-}" = "profile" ]]; then
        . "${HOME}/.profile"
    else
        printf '%s\n' "${fg_red}[!]${reset} An error occurred while reloading."
        return 1
    fi
}

# [+] ----------------------------------------------------------------| elevate

# --| Repeats last command with sudo, if forgotten.
load-source "${AEL_BIN}/elevate"

# [+] -------------------------------------------------------------------| goto

# --|  Simple directory bookmarks system.
load-source "${AEL_BIN}/goto"

# [+] -------------------------------------------------------------| reset-time

# --| Reset system time. Usefull when Windows boot screws time.
reset-time() {

    local __blue=$'\033[34m'
    local __red=$'\033[31m'
    local __reset=$'\033[0m'

    trap 'unset -f check_applications; trap - RETURN' RETURN
    
    check_applications() {
      local __app
      for __app in "${@}"; do
          if ! command -v $__app >/dev/null 2>&1; then
                printf '%s\n' "${__red}[!]${__reset} ${__app} is not installed."
                return 1
            fi
        done
    }
    check_applications date timedatectl hwclock || return 1

    printf '%s\n' "${__blue}[*]${__reset} Time before resetting system: $(date "+%F %H:%M:%S %Z")"

    sudo timedatectl set-ntp true && sudo hwclock --systohc --utc

    printf '%s\n' "${__blue}[*]${__reset} Time now: $(date "+%F %H:%M:%S %Z")"
}

# [+] -------------------------------------------------------------| shell-info

# --| Show shell info.
load-source "${AEL_BIN}/shell-info"

