#!/usr/bin/env bash
# =============================================================================
# INFO
# =============================================================================
# [/bin/deep-scan]
# 
# Author      : Pascal Malouin (https://github.com/alterEGO-Linux)
# Created     : 2026-04-03 23:33:30 UTC
# Updated     : 2026-08-31 12:39:09 UTC
# Description : Scans IP with rustscan and nmap.
# -----------------------------------------------------------------------------

deep-scan() {

    source ~/.ael/lib/bash/ael
    import applications
    import messages

    check_applications rustscan sudo nmap || return 1

    usage() {
        cat <<EOF
================================================================================
[+] deep-scan - Scans IP with rustscan and nmap.
================================================================================
Usage:
  deep-scan <Target> | [-h|--help]

Runs RustScan to find the available ports and passes the ports to Nmap.

Options:
  -h, --help    Display this help message.

Examples:
  deep-scan 192.168.1.1
  deep-scan localhost
================================================================================
EOF
    }

    # Setting IP value.
    local ip
    ip="${1:-127.0.0.1}"
    [[ "$ip" == "localhost" ]] && ip="127.0.0.1"

    # Show help and ignore other arguments.
    local i
    for i in "${@}"; do
        if [[ "${i}" == "-h" || "${i}" == "--help" ]]; then
            usage
            return 1
        fi
    done

    # Too many arguments.
    if [[ $# -gt 1 ]]; then
        message error "Too many arguments."
        usage
        return 1
    fi

    # --- rustscan ------------------------------------------------------------

    message banner "deep-scan - Scans IP with rustscan and nmap."

    message step "Running Rustscan to find open ports."

    local ports=$(rustscan -a "$ip" --ulimit 5000 --batch-size 2000 --greppable | grep -oP '\[\K[0-9,]+(?=\])')

    # --- nmap ----------------------------------------------------------------

    if [[ -n "${ports}" ]]; then
        message step "Found ${ports}."
        message step "Running Nmap."

        # Check grc availability.
        local run_nmap
        if command -v grc >/dev/null 2>&1; then
            run_nmap=(grc nmap)
        else
            run_nmap=(nmap)
        fi 

        sudo "${run_nmap[@]}" -sV -O -sC --traceroute "${ip}" -p "${ports}"
        return 0
    else
        message error "Found nothing."
        return 1
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    deep-scan "$@"
fi
